{
  "expo": {
    "name": "Code Review",
    "slug": "code-review-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "crapp",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0F172A"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      },
      "package": "com.codereview.app"
    },
    "ios": {
      "bundleIdentifier": "com.codereview.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
