[
  {"id":"hb6_01","language":"html","difficulty":"beginner","bug_type":"css","title":"Logical Properties","code":".card {\n  margin-left: 16px;\n  margin-right: 16px;\n  padding-top: 8px;\n}","bugs":[{"lines":[2],"fix":"  margin-inline: 16px;\n  padding-block-start: 8px;","explanation":"CSS Logical Properties use writing-mode-aware terminology. `margin-inline` replaces `margin-left`/`margin-right`, and `padding-block-start` replaces `padding-top`. They work correctly with RTL languages and vertical writing modes."}]},
  {"id":"hb6_02","language":"html","difficulty":"beginner","bug_type":"css","title":"gap vs margin for Spacing","code":".list {\n  display: flex;\n  flex-direction: column;\n}\n.list > * + * {\n  margin-top: 8px;\n}","bugs":[{"lines":[4],"fix":".list {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}","explanation":"The `* + * { margin-top: 8px }` pattern (lobotomized owl) adds space between sibling elements. In a flex/grid container, `gap` is simpler and more expressive. Use `gap` for spacing between flex/grid items."}]},
  {"id":"hb6_03","language":"html","difficulty":"beginner","bug_type":"css","title":"Nesting CSS (Native)","code":".card {\n  padding: 16px;\n\n  .title {\n    font-size: 1.5rem;\n  }\n\n  &:hover {\n    box-shadow: 0 4px 8px rgba(0,0,0,.2);\n  }\n}","bugs":[]},
  {"id":"hb6_04","language":"html","difficulty":"beginner","bug_type":"css","title":"@layer for Cascade Management","code":"@layer reset, base, components;\n\n@layer reset { *, *::before, *::after { box-sizing: border-box; } }\n@layer base { body { font-family: system-ui, sans-serif; } }","bugs":[]},
  {"id":"hb6_05","language":"html","difficulty":"beginner","bug_type":"css","title":"Container Queries","code":"@container (min-width: 400px) {\n  .card { flex-direction: row; }\n}\n.card-wrapper { container-type: inline-size; }","bugs":[]},
  {"id":"hb6_06","language":"html","difficulty":"beginner","bug_type":"css","title":"has() Selector","code":".form-group:has(input:invalid) label {\n  color: red;\n}","bugs":[]},
  {"id":"hb6_07","language":"html","difficulty":"beginner","bug_type":"css","title":":where() for Zero Specificity","code":":where(h1, h2, h3) {\n  font-weight: bold;\n  line-height: 1.2;\n}","bugs":[]},
  {"id":"hb6_08","language":"html","difficulty":"beginner","bug_type":"css","title":":is() for Grouping","code":":is(h1, h2, h3) > a {\n  color: inherit;\n  text-decoration: none;\n}","bugs":[]},
  {"id":"hb6_09","language":"html","difficulty":"beginner","bug_type":"css","title":"focus-visible vs focus","code":"button:focus-visible {\n  outline: 3px solid #0066cc;\n  outline-offset: 2px;\n}","bugs":[]},
  {"id":"hb6_10","language":"html","difficulty":"beginner","bug_type":"css","title":"Removing focus Outline","code":"button:focus {\n  outline: none;\n}","bugs":[{"lines":[2],"fix":"  outline: none;\n  box-shadow: 0 0 0 3px rgba(0, 102, 204, 0.5);","explanation":"Removing the focus outline without providing an alternative makes keyboard navigation impossible for sighted keyboard users. If you dislike the default outline, replace it with a custom visible focus indicator (box-shadow, border, color change). Never remove focus indication entirely."}]},
  {"id":"hb6_11","language":"html","difficulty":"beginner","bug_type":"css","title":"prefers-reduced-motion","code":"@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after {\n    animation-duration: 0.01ms !important;\n    transition-duration: 0.01ms !important;\n  }\n}","bugs":[]},
  {"id":"hb6_12","language":"html","difficulty":"beginner","bug_type":"css","title":"scroll-behavior smooth","code":"html {\n  scroll-behavior: smooth;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  html { scroll-behavior: auto; }\n}","bugs":[]},
  {"id":"hb6_13","language":"html","difficulty":"beginner","bug_type":"css","title":"overscroll-behavior","code":".modal {\n  overflow: auto;\n  overscroll-behavior: contain;\n}","bugs":[]},
  {"id":"hb6_14","language":"html","difficulty":"beginner","bug_type":"css","title":"position sticky","code":".sticky-header {\n  position: sticky;\n  top: 0;\n  z-index: 100;\n}","bugs":[]},
  {"id":"hb6_15","language":"html","difficulty":"beginner","bug_type":"css","title":"Object-fit for Images","code":".avatar {\n  width: 80px;\n  height: 80px;\n  object-fit: cover;\n  border-radius: 50%;\n}","bugs":[]},
  {"id":"hb6_16","language":"html","difficulty":"beginner","bug_type":"css","title":"overflow: clip vs hidden","code":".clipped {\n  overflow: clip;\n  overflow-clip-margin: 8px;\n}","bugs":[]},
  {"id":"hb6_17","language":"html","difficulty":"beginner","bug_type":"css","title":"text-overflow ellipsis","code":".truncate {\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}","bugs":[]},
  {"id":"hb6_18","language":"html","difficulty":"beginner","bug_type":"css","title":"line-clamp for Multi-line Truncation","code":".excerpt {\n  display: -webkit-box;\n  -webkit-line-clamp: 3;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n}","bugs":[]},
  {"id":"hb6_19","language":"html","difficulty":"beginner","bug_type":"css","title":"CSS counter for Numbered Lists","code":"ol {\n  counter-reset: item;\n  list-style: none;\n}\n\nol li::before {\n  counter-increment: item;\n  content: counter(item) '. ';\n}","bugs":[]},
  {"id":"hb6_20","language":"html","difficulty":"beginner","bug_type":"css","title":"print Stylesheet","code":"@media print {\n  nav, aside, footer { display: none; }\n  body { font-size: 12pt; color: black; }\n  a[href]::after { content: ' (' attr(href) ')'; }\n}","bugs":[]}
