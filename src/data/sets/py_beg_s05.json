  {"id":"pb5_18","language":"python","difficulty":"beginner","bug_type":"logic","title":"Negative Slice on String","code":"s = 'python'\nprint(s[-3:])","bugs":[]},
  {"id":"pb5_19","language":"python","difficulty":"beginner","bug_type":"logic","title":"in Operator Case Sensitive","code":"sentence = 'The Quick Brown Fox'\nprint('quick' in sentence)","bugs":[{"lines":[2],"fix":"print('quick' in sentence.lower())","explanation":"`in` is case-sensitive. `'quick'` is not in `'The Quick Brown Fox'` (the sentence has `'Quick'` with capital Q). Normalise to lowercase first: `'quick' in sentence.lower()`."}]},
  {"id":"pb5_20","language":"python","difficulty":"beginner","bug_type":"logic","title":"String Immutability","code":"s = 'hello'\ns[0] = 'H'\nprint(s)","bugs":[{"lines":[2],"fix":"s = 'H' + s[1:]","explanation":"Strings are immutable in Python — you cannot assign to an index. `s[0] = 'H'` raises `TypeError`. To change a character, build a new string: `s = 'H' + s[1:]`."}]}
