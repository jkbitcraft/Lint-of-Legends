  {"id":"pb5_04","language":"python","difficulty":"beginner","bug_type":"logic","title":"center With Fill Char","code":"print('hi'.center(10, '-'))","bugs":[]},
  {"id":"pb5_05","language":"python","difficulty":"beginner","bug_type":"logic","title":"lstrip Only Left Side","code":"s = '  hello  '\nprint(s.lstrip())","bugs":[{"lines":[2],"fix":"print(s.strip())","explanation":"`lstrip()` removes whitespace only from the left (leading). The right-side spaces remain. Use `strip()` to remove whitespace from both ends."}]},
