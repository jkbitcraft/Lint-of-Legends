  {"id":"pb5_11","language":"python","difficulty":"beginner","bug_type":"logic","title":"casefold for Better Lowercasing","code":"s = 'STRASSE'\nprint(s.lower())","bugs":[{"lines":[2],"fix":"print(s.casefold())","explanation":"`lower()` handles most ASCII characters but can miss locale-specific cases (e.g. German 'ß'). `casefold()` is more aggressive and better suited for case-insensitive comparisons across languages."}]},
  {"id":"pb5_12","language":"python","difficulty":"beginner","bug_type":"logic","title":"startswith Tuple Argument","code":"filename = 'report.pdf'\nif filename.endswith(('.pdf', '.docx')):\n    print('document')","bugs":[]},
  {"id":"pb5_13","language":"python","difficulty":"beginner","bug_type":"logic","title":"str.format With Missing Key","code":"msg = '{name} scored {score}'.format(name='Alice')\nprint(msg)","bugs":[{"lines":[1],"fix":"msg = '{name} scored {score}'.format(name='Alice', score=95)","explanation":"The format string references `{score}` but no `score` keyword argument is provided. Python raises `KeyError: 'score'`. Pass all required arguments."}]},
