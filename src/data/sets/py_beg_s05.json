[
  {"id":"pb5_01","language":"python","difficulty":"beginner","bug_type":"logic","title":"str.upper Returns New String","code":"s = 'hello'\ns.upper()\nprint(s)","bugs":[{"lines":[2],"fix":"s = s.upper()","explanation":"String methods return a new string — they do not modify the original. `s.upper()` creates an uppercase copy but discards it. Assign the result back: `s = s.upper()`."}]},
  {"id":"pb5_02","language":"python","difficulty":"beginner","bug_type":"logic","title":"str.count Counts Overlapping","code":"print('aaa'.count('aa'))","bugs":[]},
